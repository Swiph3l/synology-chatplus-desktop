{
  "name": "synology-chatplus-desktop",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-theme.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "tauri": "node scripts/tauri.mjs",
    "check:release": "node scripts/check-release-assets.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "sbom": "node scripts/sbom.mjs",
    "checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.15",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "8.3.8"
  },
  "description": "Unofficial cross-platform messaging client for Synology ChatPlus, Synology Chat and experimental integrations.",
  "author": "Swiph3l",
  "repository": {
    "type": "git",
    "url": "https://github.com/Swiph3l/synology-chatplus-desktop.git"
  },
  "homepage": "https://github.com/Swiph3l/synology-chatplus-desktop",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
