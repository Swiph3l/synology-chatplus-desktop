{
  "name": "synology-chatplus-desktop",
  "version": "0.5.0-beta.4",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-theme.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "tauri": "node scripts/tauri.mjs",
    "check:release": "node scripts/check-release-assets.mjs",
    "sbom": "node scripts/sbom.mjs",
    "checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "vite": "^7.3.7"
  },
  "description": "Unofficial community desktop client for Synology ChatPlus.",
  "author": "Swiph3l",
  "repository": {
    "type": "git",
    "url": "https://github.com/Swiph3l/synology-chatplus-desktop.git"
  },
  "homepage": "https://github.com/Swiph3l/synology-chatplus-desktop"
}
